{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "~/.claude/skills/personal/hooks/notify.sh",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "~/.claude/skills/personal/hooks/notify.sh",
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "async": true,
            "command": "~/.claude/skills/personal/hooks/notify.sh",
            "type": "command"
          }
        ]
      }
    ]
  }
}
