{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "personal@skills-dir": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/notify.sh",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "id=$(cat | jq -r '.session_id'); rd agent event TOOL_CALL_START --id \"perm-$id\" --type elicitation --harness claude",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "id=$(cat | jq -r '.tool_use_id'); rd agent event TOOL_CALL_RESULT --id \"$id\" --type elicitation --harness claude",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion|ExitPlanMode"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "id=$(cat | jq -r '.session_id'); rd agent event TOOL_CALL_RESULT --id \"perm-$id\" --type elicitation --harness claude",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "id=$(cat | jq -r '.tool_use_id'); rd agent event TOOL_CALL_RESULT --id \"$id\" --harness claude",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "id=$(cat | jq -r '.tool_use_id'); rd agent event TOOL_CALL_START --id \"$id\" --type elicitation --harness claude",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion|ExitPlanMode"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "id=$(cat | jq -r '.tool_use_id'); rd agent event TOOL_CALL_START --id \"$id\" --harness claude",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "rd agent clear",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "id=$(cat | jq -r '.session_id'); rd agent event SESSION_STARTED --id \"$id\" --harness claude",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "~/.claude/hooks/notify.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "payload=$(cat); id=$(echo \"$payload\" | jq -r '.session_id'); n=$(echo \"$payload\" | jq -r '(.background_tasks // []) | length'); rd agent event RUN_FINISHED --id \"$id\" --active-tools \"$n\" --harness claude",
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "async": true,
            "command": "~/.claude/hooks/notify.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "payload=$(cat); id=$(echo \"$payload\" | jq -r '.session_id'); n=$(echo \"$payload\" | jq -r '(.background_tasks // []) | length'); rd agent event RUN_FINISHED --id \"$id\" --active-tools \"$n\" --harness claude",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "async": true,
            "command": "id=$(cat | jq -r '.session_id'); rd agent event RUN_STARTED --id \"$id\" --harness claude",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "sonnet[1m]",
  "permissions": {
    "allow": [
      "Read(//tmp/**)",
      "Read(//private/tmp/**)",
      "Edit(//tmp/**)",
      "Edit(//private/tmp/**)",
      "Bash(brew *)",
      "Bash(cat *)",
      "Bash(cut *)",
      "Bash(env)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(openspec instructions *)",
      "Bash(openspec list *)",
      "Bash(openspec show *)",
      "Bash(openspec status *)",
      "Bash(openspec validate *)",
      "Bash(printenv *)",
      "Bash(pwd)",
      "Bash(rg *)",
      "Bash(stat *)",
      "Bash(stow *)",
      "Bash(tail *)",
      "Bash(tree *)",
      "Bash(type *)",
      "Bash(uname *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(whoami)",
      "Bash(* --version)",
      "Bash(* --help *)",
      "Bash(rtk diff *)",
      "Bash(rtk env)",
      "Bash(rtk find *)",
      "Bash(rtk gh *)",
      "Bash(rtk git *)",
      "Bash(rtk grep *)",
      "Bash(rtk json *)",
      "Bash(rtk ls *)",
      "Bash(rtk npm *)",
      "Bash(rtk npx *)",
      "Bash(rtk read *)",
      "Bash(rtk rg *)",
      "Bash(rtk tree *)",
      "Bash(rtk wc *)",
      "mcp__codegraph__codegraph_explore",
      "mcp__codegraph__codegraph_search",
      "mcp__codegraph__codegraph_node",
      "mcp__codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_callees",
      "mcp__codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_files",
      "mcp__codegraph__codegraph_status",
      "mcp__git__get_commit",
      "mcp__git__get_file_contents",
      "mcp__git__get_label",
      "mcp__git__get_latest_release",
      "mcp__git__get_me",
      "mcp__git__get_release_by_tag",
      "mcp__git__get_tag",
      "mcp__git__get_team_members",
      "mcp__git__get_teams",
      "mcp__git__issue_read",
      "mcp__git__list_branches",
      "mcp__git__list_commits",
      "mcp__git__list_issue_types",
      "mcp__git__list_issues",
      "mcp__git__list_pull_requests",
      "mcp__git__list_releases",
      "mcp__git__list_tags",
      "mcp__git__pull_request_read",
      "mcp__git__search_code",
      "mcp__git__search_issues",
      "mcp__git__search_pull_requests",
      "mcp__git__search_repositories",
      "mcp__git__search_users",
      "mcp__atlassian__getAccessibleAtlassianResources",
      "mcp__atlassian__getConfluencePage",
      "mcp__atlassian__getConfluencePageDescendants",
      "mcp__atlassian__getJiraIssue",
      "mcp__atlassian__search"
    ],
    "defaultMode": "bypassPermissions"
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "theme": "auto"
}