const APP_NAME = "agentctl";
/**
 * Resolve the platform log directory: the XDG state dir (Linux:
 * `$XDG_STATE_HOME` or `~/.local/state`), else the local data dir
 * (macOS: `~/Library/Application Support`), joined with `<app>/logs`.
 * Pure: no I/O.
 */ function src_logDir(appName = APP_NAME, platform = process.platform, env = process.env, home = (0,external_node_os_.homedir)()) {
    if (!home) return undefined;
    let base;
    if (platform === "darwin") {
        base = (0,external_node_path_.join)(home, "Library", "Application Support");
    } else if (platform === "win32") {
        base = env.LOCALAPPDATA ?? (0,external_node_path_.join)(home, "AppData", "Local");
    } else {
        const xdg = env.XDG_STATE_HOME;
        base = xdg?.startsWith("/") ? xdg : (0,external_node_path_.join)(home, ".local", "state");
    }
    return (0,external_node_path_.join)(base, appName, "logs");
}
function pad(n) {
    return String(n).padStart(2, "0");
}
/** `<dir>/<app>.log.YYYY-MM-DD` using the local date. Pure: no I/O. */ function src_currentLogFile(dir, appName = APP_NAME, now = new Date()) {
    const date = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
    return (0,external_node_path_.join)(dir, `${appName}.log.${date}`);
}
/** Keep only the `retentionCount` most recently modified `<app>.log.*` files. */ function pruneLogs(dir, appName, retentionCount) {
    const prefix = `${appName}.log.`;
    let names;
    try {
        names = (0,external_node_fs_.readdirSync)(dir);
    } catch  {
        return;
    }
    const files = [];
    for (const name of names){
        if (!name.startsWith(prefix)) continue;
        const path = (0,external_node_path_.join)(dir, name);
        try {
            files.push({
                path,
                mtime: (0,external_node_fs_.statSync)(path).mtimeMs
            });
        } catch  {
        // ignore unreadable entries
        }
    }
    files.sort((a, b)=>b.mtime - a.mtime);
    for (const { path } of files.slice(retentionCount)){
        try {
            (0,external_node_fs_.unlinkSync)(path);
        } catch  {
        // best-effort
        }
    }
}
const NOOP_LOGGER = {
    debug () {},
    info () {},
    warn () {},
    error () {}
};
/**
 * Initialise file logging (pino, synchronous file destination). Best-effort:
 * returns a no-op logger when the directory cannot be resolved or written.
 */ function initLogging(level, appName = APP_NAME) {
    try {
        const dir = src_logDir(appName);
        if (!dir) return NOOP_LOGGER;
        (0,external_node_fs_.mkdirSync)(dir, {
            recursive: true
        });
        pruneLogs(dir, appName, 7);
        const destination = pino_default().destination({
            dest: src_currentLogFile(dir, appName),
            sync: true,
            mkdir: true
        });
        const log = pino_default()({
            level,
            base: undefined
        }, destination);
        // Surface (and swallow) late write failures instead of crashing.
        destination.on("error", ()=>{});
        return {
            debug: (msg)=>log.debug(msg),
            info: (msg)=>log.info(msg),
            warn: (msg)=>log.warn(msg),
            error: (msg)=>log.error(msg)
        };
    } catch  {
        return NOOP_LOGGER;
    }
}

