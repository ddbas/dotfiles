;// CONCATENATED MODULE: ../../packages/tmux/src/index.ts

const FORMAT = "#{pane_current_command}\t#{session_name}\t#{window_index}\t#{pane_index}\t#{pane_pid}\t#{pane_id}";
const MAX_BUFFER = 64 * 1024 * 1024;
/** Parse like Rust `u32::parse().unwrap_or(0)`. */ function parseU32(s) {
    if (!/^\+?\d+$/.test(s)) return 0;
    const n = Number(s);
    return n <= 0xffff_ffff ? n : 0;
}
/** Split into at most `limit` parts; the last part keeps remaining separators. */ function splitN(line, sep, limit) {
    const parts = [];
    let rest = line;
    while(parts.length < limit - 1){
        const i = rest.indexOf(sep);
        if (i < 0) break;
        parts.push(rest.slice(0, i));
        rest = rest.slice(i + sep.length);
    }
    parts.push(rest);
    return parts;
}
/** Rust `str::lines`: split on `\n`, strip a trailing `\r`, no trailing empty line. */ function src_lines(text) {
    const out = text.split("\n");
    if (out.at(-1) === "") out.pop();
    return out.map((l)=>l.endsWith("\r") ? l.slice(0, -1) : l);
}
/** Parse the output of `tmux list-panes -a -F <FORMAT>`. */ function parsePanes(stdout) {
    const panes = [];
    for (const line of src_lines(stdout)){
        const parts = splitN(line, "\t", 6);
        if (parts.length < 6) continue;
        const [agent, session, win, pane, pid, paneId] = parts;
        panes.push({
            agent,
            session,
            windowIndex: parseU32(win),
            paneIndex: parseU32(pane),
            panePid: parseU32(pid),
            paneId
        });
    }
    return panes;
}
/** Parse `ps -A -o pid=,ppid=,args=` into parent-PID → child argv[0] basenames. */ function parseProcessTable(stdout) {
    const table = new Map();
    for (const line of src_lines(stdout)){
        const tokens = line.split(/\s+/).filter((t)=>t !== "");
        const pid = tokens[0] !== undefined ? parseNumber(tokens[0]) : undefined;
        const ppid = tokens[1] !== undefined ? parseNumber(tokens[1]) : undefined;
        const argv0 = tokens[2] ?? "";
        const basename = argv0.slice(argv0.lastIndexOf("/") + 1);
        if (pid !== undefined && ppid !== undefined) {
            const children = table.get(ppid);
            if (children) children.push(basename);
            else table.set(ppid, [
                basename
            ]);
        }
    }
    return table;
}
function parseNumber(s) {
    return /^\+?\d+$/.test(s) && Number(s) <= 0xffff_ffff ? Number(s) : undefined;
}
/** `Tmux` port implementation shelling out to `tmux` and `ps`. */ class ExecTmux {
    listPanes(server) {
        const args = server !== undefined ? [
            "-S",
            server
        ] : [];
        args.push("list-panes", "-a", "-F", FORMAT);
        const result = (0,external_node_child_process_namespaceObject.spawnSync)("tmux", args, {
            encoding: "utf8",
            maxBuffer: MAX_BUFFER
        });
        if (result.error) {
            const code = result.error.code;
            if (code === "ENOENT") {
                throw new Error("tmux not found — is tmux installed and on PATH?");
            }
            throw new Error(`failed to run tmux: ${result.error.message}`);
        }
        // Non-zero exit means no server running → empty list.
        if (result.status !== 0) return [];
        return parsePanes(result.stdout);
    }
    processTable() {
        const result = (0,external_node_child_process_namespaceObject.spawnSync)("ps", [
            "-A",
            "-o",
            "pid=,ppid=,args="
        ], {
            encoding: "utf8",
            maxBuffer: MAX_BUFFER
        });
        if (result.error || result.status !== 0) return new Map();
        return parseProcessTable(result.stdout);
    }
}

