];
/** Canonical sort priority: blocked < done < working < idle < unknown. */ const PRIORITY = {
    blocked: 0,
    done: 1,
    working: 2,
    idle: 3,
    unknown: 4
};
function compareAgentState(a, b) {
    return PRIORITY[a] - PRIORITY[b];
}

;// CONCATENATED MODULE: ../../packages/core/src/time.ts
/** RFC 3339 helpers matching chrono's output (UTC, millisecond precision). */ /**
 * chrono `Debug`/serde form for a UTC instant given in epoch microseconds:
 * `2026-01-01T00:00:00Z`, `...00.123Z` or `...00.123456Z` (fractional digits
 * only as needed, in groups of three).
 */ function formatMicros(epochMicros) {
    const ms = Math.floor(epochMicros / 1000);
    const frac = ms % 1000 * 1000 + (epochMicros - ms * 1000);
    const base = new Date(ms).toISOString().slice(0, 19);
    if (frac === 0) return `${base}Z`;
    const digits = String(frac).padStart(6, "0");
    return `${base}.${frac % 1000 === 0 ? digits.slice(0, 3) : digits}Z`;
}
/** chrono form for a `Date` (millisecond precision). */ function formatTimestamp(date) {
    return formatMicros(date.getTime() * 1000);
}
/** chrono `to_rfc3339()` form: `2026-01-01T00:00:00+00:00`. */ function toRfc3339(timestamp) {
    return timestamp.endsWith("Z") ? `${timestamp.slice(0, -1)}+00:00` : timestamp;
}
/** Epoch millis for sorting; `-Infinity` when unparsable. */ function timestampMillis(timestamp) {
    const ms = Date.parse(timestamp);
    return Number.isNaN(ms) ? Number.NEGATIVE_INFINITY : ms;
}
/** Current instant as a chrono-style RFC 3339 UTC string (microsecond precision). */ function nowTimestamp() {
    const micros = Math.floor((performance.timeOrigin + performance.now()) * 1000);
    return formatMicros(micros);
}

