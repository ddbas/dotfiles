#!/usr/bin/env bash
# Renders one colored dot per `rd list` agent pane for the tmux status bar.
# idle=grey, done=green, working=yellow, blocked=red, sorted in that order.
# A `done` agent with an in-flight tool call (e.g. a monitoring/long-running
# tool it's waiting on) is treated as `working` (yellow) instead of `done`.
set -euo pipefail

RD_BIN=$(command -v rd || echo "$HOME/.local/bin/rd")

lines=$("$RD_BIN" list -c status,activeTools 2>/dev/null) || exit 0
[[ -z "$lines" ]] && exit 0

rank_and_color() {
  case "$1" in
    idle) echo "0 colour8" ;;
    done) echo "1 green" ;;
    working) echo "2 yellow" ;;
    blocked) echo "3 red" ;;
    *) echo "4 colour8" ;;
  esac
}

ranked=""
while read -r status activeTools; do
  [[ -z "$status" ]] && continue
  [[ "$status" == "done" && -n "$activeTools" ]] && status="working"
  ranked+="$(rank_and_color "$status")"$'\n'
done <<< "$lines"

[[ -z "$ranked" ]] && exit 0

dots=""
while read -r rank color; do
  [[ -z "$rank" ]] && continue
  dots+="#[fg=${color}]●"
done < <(printf '%s' "$ranked" | sort -k1,1n)

printf '%s#[fg=colour8] | ' "$dots"
