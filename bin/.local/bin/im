;// CONCATENATED MODULE: ../../packages/domain/src/status-machine.ts
/**
 * Authoritative table of legal status transitions. `Task.claim` and
 * `Task.close` both consult it. `Blocked` has no transitions into or out of
 * it yet.
 */ const TRANSITIONS = {
    claim: {
        Open: "InProgress"
    },
    close: {
        InProgress: "Closed"
    }
};
function transition(name, status) {
    const table = TRANSITIONS[name];
    return table[status];
}
/** `Open` → `InProgress`; `undefined` for every other status. */ const claim = (status)=>transition("claim", status);
/** `InProgress` → `Closed`; `undefined` for every other status. */ const status_machine_close = (status)=>transition("close", status);

// EXTERNAL MODULE: ../../packages/domain/src/types.ts + 2 modules
var types = __webpack_require__(688);
;// CONCATENATED MODULE: ../../packages/domain/src/task.ts



/** Creates a new, open task with an auto-generated id and default fields. */ function newTask(title, now = new Date()) {
    return {
        id: (0,types/* .newId */.Si)(),
        title,
        taskType: (/* inlined export .DEFAULT_TASK_TYPE */"task"),
        status: (/* inlined export .DEFAULT_STATUS */"Open"),
        description: "",
        acceptanceCriteria: [],
        comments: [],
        priority: (/* inlined export .DEFAULT_PRIORITY */"p2"),
        relationships: [],
        parent: undefined,
        createdAt: now,
        updatedAt: now
    };
}
/** Creates a new, not-yet-done acceptance criterion with a fresh id. */ function newAcceptanceCriterion(text) {
    return {
        id: newId(),
        text,
        done: false
    };
}
/**
 * Sets the task's parent. An epic can never have a parent; the other half of
 * the invariant (the parent must be an epic) is enforced by the application
 * layer, which can look up the candidate.
 */ function setParent(task, parent) {
    if (task.taskType === "epic") {
        return (0,result/* .err */._)({
            kind: "EpicsCannotHaveParents"
        });
    }
    return (0,result.ok)({
        ...task,
        parent,
        updatedAt: new Date()
    });
}
/** Clears the task's parent. */ function clearParent(task) {
    return {
        ...task,
        parent: undefined,
        updatedAt: new Date()
    };
}
/** Moves a task back to `Open`. */ function reopen(task) {
    return {
        ...task,
        status: "Open",
        updatedAt: new Date()
    };
}
/** `Open` → `InProgress`. */ function claimTask(task) {
    const next = claim(task.status);
    if (next === undefined) {
        return (0,result/* .err */._)({
            kind: "NotOpen",
            current: task.status
        });
    }
    return (0,result.ok)({
        ...task,
        status: next,
        updatedAt: new Date()
    });
}
/**
 * `InProgress` → `Closed`, only once every acceptance criterion is done. The
 * transition is checked first, then the acceptance-criteria rule.
 */ function closeTask(task) {
    const next = status_machine_close(task.status);
    if (next === undefined) {
        return (0,result/* .err */._)({
            kind: "NotInProgress",
            current: task.status
        });
    }
    const remaining = task.acceptanceCriteria.filter((criterion)=>!criterion.done).map((criterion)=>criterion.id);
    if (remaining.length > 0) {
        return (0,result/* .err */._)({
            kind: "IncompleteAcceptanceCriteria",
            remaining
        });
    }
    return (0,result.ok)({
        ...task,
        status: next,
        updatedAt: new Date()
    });
}

;// CONCATENATED MODULE: ../../packages/application/src/app.ts

/** Every subcommand exposed by an adapter maps to one `App` method. */ class App {
    #repository;
    constructor(repository){
        this.#repository = repository;
    }
    /**
   * Lists non-closed tasks, oldest first (by `createdAt`). Rendering is left
   * to the caller.
   */ list() {
        const all = this.#repository.listAll();
        if (!all.ok) return all;
        return (0,result.ok)(all.value.filter((task)=>task.status !== "Closed").sort((a, b)=>a.createdAt.getTime() - b.createdAt.getTime()));
    }
    /** Creates a task and returns a one-line confirmation. */ create(title, options = {}) {
        const trimmed = title.trim();
        if (trimmed === "") return (0,result/* .err */._)({
            kind: "BlankTitle"
        });
        let task = {
            ...newTask(trimmed),
            ...options.taskType !== undefined && {
                taskType: options.taskType
            },
            ...options.priority !== undefined && {
                priority: options.priority
            },
            ...options.description !== undefined && {
                description: options.description
            }
        };
        if (options.parent !== undefined) {
            const withParent = this.#applyParent(task, options.parent);
            if (!withParent.ok) return withParent;
            task = withParent.value;
        }
        const saved = this.#repository.save(task);
        if (!saved.ok) return saved;
        return (0,result.ok)(`Created ${task.id} ${task.title}`);
    }
    /**
   * Moves a task from `Open` to `InProgress`. Idempotent when already in
   * progress (succeeds without saving).
   */ claim(id) {
        const found = this.#repository.findById(id);
        if (!found.ok) return found;
        const task = found.value;
        if (task === undefined) return (0,result/* .err */._)({
            kind: "NotFound",
            id
        });
        if (task.status === "InProgress") {
            return (0,result.ok)(`${task.id} is already in progress`);
        }
        const claimed = claimTask(task);
        if (!claimed.ok) return (0,result/* .err */._)(claimed.error);
        const saved = this.#repository.save(claimed.value);
        if (!saved.ok) return saved;
        return (0,result.ok)(`Claimed ${task.id} ${task.title}`);
    }
    /** Partially updates an existing task and returns a confirmation. */ update(id, options) {
        if (options.parent !== undefined && options.clearParent) {
            return (0,result/* .err */._)({
                kind: "ConflictingParentFlags"
            });
        }
        if (options.title === undefined && options.taskType === undefined && options.priority === undefined && options.description === undefined && options.parent === undefined && !options.clearParent) {
            return (0,result/* .err */._)({
                kind: "NoChanges"
            });
        }
        const found = this.#repository.findById(id);
        if (!found.ok) return found;
        if (found.value === undefined) return (0,result/* .err */._)({
            kind: "NotFound",
            id
        });
        let task = found.value;
        if (options.title !== undefined) {
            const trimmed = options.title.trim();
            if (trimmed === "") return (0,result/* .err */._)({
                kind: "BlankTitle"
            });
            task = {
                ...task,
                title: trimmed
            };
        }
        if (options.taskType !== undefined) {
            task = {
                ...task,
                taskType: options.taskType
            };
        }
        if (options.priority !== undefined) {
            task = {
                ...task,
                priority: options.priority
            };
        }
        if (options.description !== undefined) {
            task = {
                ...task,
                description: options.description
            };
        }
        if (options.parent !== undefined) {
            const withParent = this.#applyParent(task, options.parent);
            if (!withParent.ok) return withParent;
            task = withParent.value;
        } else if (options.clearParent) {
            task = clearParent(task);
        }
        const saved = this.#repository.save(task);
        if (!saved.ok) return saved;
        return (0,result.ok)(`Updated ${task.id} ${task.title}`);
    }
    /**
   * Moves a task from `InProgress` to `Closed`. Idempotent when already
   * closed (succeeds without saving).
   */ close(id) {
        const found = this.#repository.findById(id);
        if (!found.ok) return found;
        const task = found.value;
        if (task === undefined) return (0,result/* .err */._)({
            kind: "NotFound",
            id
        });
        if (task.status === "Closed") return (0,result.ok)(`${task.id} is already closed`);
        const closed = closeTask(task);
        if (closed.ok) {
            const saved = this.#repository.save(closed.value);
            if (!saved.ok) return saved;
            return (0,result.ok)(`Closed ${task.id} ${task.title}`);
        }
        if (closed.error.kind === "NotInProgress") return (0,result/* .err */._)(closed.error);
        const incomplete = closed.error.remaining;
        return (0,result/* .err */._)({
            kind: "IncompleteAcceptanceCriteria",
            remaining: task.acceptanceCriteria.filter((criterion)=>incomplete.includes(criterion.id)).map((criterion)=>criterion.text)
        });
    }
    /** Resolves `parentId` against the repository and sets it on `task`. */ #applyParent(task, parentId) {
        const found = this.#repository.findById(parentId);
        if (!found.ok) return found;
        const parent = found.value;
        if (parent === undefined) {
            return (0,result/* .err */._)({
                kind: "ParentNotFound",
                id: parentId
            });
        }
        if (parent.taskType !== "epic") {
            return (0,result/* .err */._)({
                kind: "ParentIsNotAnEpic",
                id: parentId
            });
        }
        const updated = setParent(task, parentId);
        if (!updated.ok) return (0,result/* .err */._)({
            kind: "EpicCannotHaveParent"
        });
        return updated;
    }
}


