/** The name of the application under the OS per-user data directory. */ const APP_NAME = "imember";
/** The name of the JSON file tasks are persisted to. */ const TASKS_FILE_NAME = "tasks.json";
const repository_message = (error)=>error instanceof Error ? error.message : String(error);
/**
 * A {@link TaskRepository} backed by a single JSON file containing an array
 * of tasks. A deliberate storage prototype: it reads the whole file on every
 * call and has no locking.
 */ class JsonTaskRepository {
    #path;
    constructor(filePath){
        this.#path = filePath;
    }
    /**
   * Backs a repository with the JSON file at `filePath`, creating its parent
   * directory and an empty `[]` file if they do not exist. Tests should use
   * a temporary directory.
   */ static at(filePath) {
        if (!external_node_fs_default().existsSync(filePath)) {
            const dir = external_node_path_default().dirname(filePath);
            try {
                external_node_fs_default().mkdirSync(dir, {
                    recursive: true
                });
            } catch (error) {
                return (0,src_result/* .err */._)(repositoryError(`failed to create data directory ${dir}: ${repository_message(error)}`));
            }
            try {
                external_node_fs_default().writeFileSync(filePath, "[]");
            } catch (error) {
                return (0,src_result/* .err */._)(repositoryError(`failed to create tasks file ${filePath}: ${repository_message(error)}`));
            }
        }
        return (0,src_result.ok)(new JsonTaskRepository(filePath));
    }
    /** Backs a repository with `tasks.json` in the OS per-user data directory. */ static inDataDir() {
        const { data } = envPaths(APP_NAME, {
            suffix: ""
        });
        return JsonTaskRepository.at(external_node_path_default().join(data, TASKS_FILE_NAME));
    }
    #read() {
        let contents;
        try {
            contents = external_node_fs_default().readFileSync(this.#path, "utf8");
        } catch (error) {
            return (0,src_result/* .err */._)(repositoryError(`failed to read tasks file ${this.#path}: ${repository_message(error)}`));
        }
        try {
            return (0,src_result.ok)(decodeTasks(contents));
        } catch (error) {
            return (0,src_result/* .err */._)(repositoryError(`failed to parse tasks file ${this.#path} as JSON: ${repository_message(error)}`));
        }
    }
    listAll() {
        return this.#read();
    }
    findById(id) {
        const tasks = this.#read();
        if (!tasks.ok) return tasks;
        return (0,src_result.ok)(tasks.value.find((task)=>task.id === id));
    }
    save(task) {
        const tasks = this.#read();
        if (!tasks.ok) return tasks;
        const index = tasks.value.findIndex((existing)=>existing.id === task.id);
        if (index >= 0) tasks.value[index] = task;
        else tasks.value.push(task);
        try {
            external_node_fs_default().writeFileSync(this.#path, encodeTasks(tasks.value));
        } catch (error) {
            return (0,src_result/* .err */._)(repositoryError(`failed to write tasks file ${this.#path}: ${repository_message(error)}`));
        }
        return (0,src_result.ok)(undefined);
    }
}

