/** Renders any application error as the message shown to the user. */ function formatError(error) {
    switch(error.kind){
        case "Repository":
            return error.message;
        case "BlankTitle":
            return "title must not be empty";
        case "ParentNotFound":
            return `parent task ${error.id} not found`;
        case "ParentIsNotAnEpic":
            return `parent task ${error.id} is not an epic`;
        case "EpicCannotHaveParent":
            return "an epic cannot have a parent";
        case "NotFound":
            return `task ${error.id} not found`;
        case "NotOpen":
            return `task is not open (current status: ${error.current})`;
        case "NotInProgress":
            return `task is not in progress (current status: ${error.current})`;
        case "IncompleteAcceptanceCriteria":
            return `task has incomplete acceptance criteria: ${error.remaining.join(", ")}`;
        case "NoChanges":
            return "no changes specified";
        case "ConflictingParentFlags":
            return "--parent and --clear-parent cannot both be given";
        default:
            {
                const unreachable = error;
                return unreachable;
            }
    }
}

__webpack_require__.d(__webpack_exports__, {
  W: () => (formatError)
});


