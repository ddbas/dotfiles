/**
 * Renders a single `im list` row: `<status_icon> <id> ● <priority> [<type>]
 * <title>`, coloring the priority and the type per level.
 */ function renderTaskLine(task) {
    const priority = (0,external_node_util_.styleText)(PRIORITY_COLORS[task.priority], `● ${task.priority.toUpperCase()}`);
    const type = (0,external_node_util_.styleText)(TYPE_COLORS[task.taskType], `[${task.taskType}]`);
    return `${STATUS_ICONS[task.status]} ${task.id} ${priority} ${type} ${task.title}`;
}

