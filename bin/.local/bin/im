;// CONCATENATED MODULE: ../../packages/adapter-json/src/codec.ts

class DecodeError extends Error {
}
const isObject = (value)=>typeof value === "object" && value !== null && !Array.isArray(value);
function field(obj, name) {
    if (!(name in obj)) throw new DecodeError(`missing field \`${name}\``);
    return obj[name];
}
function str(obj, name) {
    const value = field(obj, name);
    if (typeof value !== "string") {
        throw new DecodeError(`field \`${name}\` must be a string`);
    }
    return value;
}
function oneOf(obj, name, allowed) {
    const value = str(obj, name);
    const found = allowed.find((candidate)=>candidate === value);
    if (found === undefined) {
        throw new DecodeError(`field \`${name}\` has invalid value \`${value}\``);
    }
    return found;
}
function date(obj, name) {
    const result = new Date(str(obj, name));
    if (Number.isNaN(result.getTime())) {
        throw new DecodeError(`field \`${name}\` must be an ISO-8601 date`);
    }
    return result;
}
function taskId(obj, name) {
    const id = (0,types/* .parseTaskId */.ik)(str(obj, name));
    if (id === undefined) throw new DecodeError(`field \`${name}\` is not a valid id`);
    return id;
}
function list(obj, name) {
    const value = field(obj, name);
    if (!Array.isArray(value)) {
        throw new DecodeError(`field \`${name}\` must be an array`);
    }
    return value.map((item)=>{
        if (!isObject(item)) throw new DecodeError(`\`${name}\` items must be objects`);
        return item;
    });
}
function decodeTask(raw) {
    if (!isObject(raw)) throw new DecodeError("task must be an object");
    const parent = raw.parent;
    return {
        id: taskId(raw, "id"),
        title: str(raw, "title"),
        taskType: oneOf(raw, "taskType", types/* .TASK_TYPES */.ci),
        status: oneOf(raw, "status", types/* .STATUSES */.f),
        description: str(raw, "description"),
        acceptanceCriteria: list(raw, "acceptanceCriteria").map((c)=>{
            const done = field(c, "done");
            if (typeof done !== "boolean") {
                throw new DecodeError("field `done` must be a boolean");
            }
            return {
                id: str(c, "id"),
                text: str(c, "text"),
                done
            };
        }),
        comments: list(raw, "comments").map((c)=>({
                id: str(c, "id"),
                body: str(c, "body"),
                createdAt: date(c, "createdAt")
            })),
        priority: oneOf(raw, "priority", types/* .PRIORITIES */.BE),
        relationships: list(raw, "relationships").map((r)=>({
                relatedTask: taskId(r, "relatedTask"),
                kind: oneOf(r, "kind", types/* .RELATIONSHIP_KINDS */.JR)
            })),
        parent: parent === undefined || parent === null ? undefined : taskId(raw, "parent"),
        createdAt: date(raw, "createdAt"),
        updatedAt: date(raw, "updatedAt")
    };
}
/** Serializes tasks to the on-disk JSON representation. */ function encodeTasks(tasks) {
    return JSON.stringify(tasks.map((task)=>({
            ...task,
            parent: task.parent ?? null
        })));
}
/** Parses and validates the on-disk JSON; throws `Error` with a message. */ function decodeTasks(contents) {
    const parsed = JSON.parse(contents);
    if (!Array.isArray(parsed)) throw new DecodeError("expected a JSON array");
    return parsed.map(decodeTask);
}

