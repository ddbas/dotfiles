        const taskId = id(raw);
        if (taskId === undefined) return;
        let parent;
        if (flags.parent !== undefined) {
            parent = id(flags.parent, "--parent id");
            if (parent === undefined) return;
        }
        const options = {
            title: flags.title,
            taskType: flags.type,
            priority: flags.priority,
            description: flags.description,
            parent,
            clearParent: flags.clearParent ?? false
        };
        report(app.update(taskId, options));
    });
    // Subcommands inherit `exitOverride` only if it is set before they are
    // created, so apply it to each explicitly.
    for (const command of program.commands)command.exitOverride();
    return program;
}


