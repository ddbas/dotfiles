#!/usr/bin/env bash

current_session=$(tmux display-message -p '#S' 2>/dev/null)

selected=$(tmux list-sessions -F '#S' | grep -v "^${current_session}$" | { echo "$current_session"; cat; } | fzf \
  --prompt="🖥️  Session: " \
  --no-sort \
  --layout=reverse \
  --border=rounded \
  --border-label=" Select session ")

if [[ -z $selected ]]; then
  exit 1
fi

if [[ -z $TMUX ]]; then
  tmux attach-session -t "$selected"
else
  tmux switch-client -t "$selected"
fi
