#!/usr/bin/env bash

# Navigate to an agent harness pane by picking from `rd list` via fzf.
# Intended to be launched as a temporary tmux window (tmux neww).

rd_output=$(rd list --sort-by status --columns session,status,activeTools,pane 2>/dev/null)

if [[ -z $rd_output ]]; then
  echo "No agent harness panes found."
  sleep 2
  exit 0
fi

selected=$(echo "$rd_output" | fzf \
  --ansi \
  --prompt="🤖 Agent: " \
  --no-sort \
  --layout=reverse \
  --border=rounded \
  --border-label=" Navigate to agent ")

if [[ -z $selected ]]; then
  exit 0
fi

# Output format: <session>  <status>  <activeTools>  <window>.<pane>
# The session name may contain arbitrary characters/spacing (e.g. emoji
# with variation selectors, multi-space separators), so we don't split on
# whitespace and rejoin (that collapses/loses the original spacing and can
# produce a session name that doesn't match any real tmux session). Instead
# we peel columns off the *end* of the line, since each trailing column has
# a predictable shape: pane is always `\d+\.\d+`; activeTools, when
# rendered at all, is `<N> tool` or `<N> tools` (not a bare digit); status
# is always a single word. Whatever remains after peeling all three is the
# session name, verbatim.
parsed=$(python3 -c '
import re, sys
line = sys.stdin.readline().rstrip("\n")
m = re.search(r"(\d+\.\d+)\s*$", line)
if not m:
    sys.exit(1)
win_pane = m.group(1)
rest = line[:m.start()].rstrip()
m = re.search(r"\d+\s+tools?\s*$", rest)
if m:
    rest = rest[:m.start()].rstrip()
m = re.search(r"(\S+)\s*$", rest)
if not m:
    sys.exit(1)
session = rest[:m.start()].rstrip()
print(session)
print(win_pane)
' <<<"$selected")

if [[ -z $parsed ]]; then
  echo "Failed to parse selection."
  sleep 2
  exit 1
fi

session=$(echo "$parsed" | sed -n '1p')
win_pane=$(echo "$parsed" | sed -n '2p')

window="${win_pane%%.*}"
pane="${win_pane##*.}"

# Resolve by ID, not name: tmux's target syntax treats "." and ":" in a
# name as window/pane separators, so names like "🌳 repo (branch/with.dots)"
# break name-based targets even on an exact match (see bin/project for the
# same fix).
session_id=$(tmux list-sessions -F '#{session_id}	#{session_name}' 2>/dev/null | awk -F'\t' -v n="$session" '$2 == n {print $1; exit}')
if [[ -z $session_id ]]; then
  echo "Session '$session' not found."
  sleep 2
  exit 1
fi

tmux switch-client -t "$session_id"
tmux select-window -t "${session_id}:${window}"
tmux select-pane -t "${session_id}:${window}.${pane}"
