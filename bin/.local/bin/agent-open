#!/usr/bin/env bash

# Navigate to an agent harness pane by picking from `rd list` via fzf.
# Intended to be launched as a temporary tmux window (tmux neww).

rd_output=$(rd list --sort-by status --columns session,status,activeTools,pane 2>/dev/null)

if [[ -z $rd_output ]]; then
  echo "No agent harness panes found."
  sleep 2
  exit 0
fi

selected=$(echo "$rd_output" | fzf \
  --ansi \
  --prompt="🤖 Agent: " \
  --no-sort \
  --layout=reverse \
  --border=rounded \
  --border-label=" Navigate to agent ")

if [[ -z $selected ]]; then
  exit 0
fi

# Output format: <session>  <status>  <activeTools>  <window>.<pane>
# The session name may contain arbitrary characters/spacing (e.g. emoji
# with variation selectors, multi-space separators), so we don't split on
# whitespace and rejoin (that collapses/loses the original spacing and can
# produce a session name that doesn't match any real tmux session). Instead
# we peel off the two trailing columns we don't need: pane (always the
# well-known `\d+\.\d+` token) and, if present, activeTools (only rendered
# when non-zero, as a bare digit run with no decimal point). What remains
# after those is <session><whitespace><status>, and status is a single
# word, so the last whitespace-delimited token is status and everything
# before it verbatim is the session name.
parsed=$(python3 -c '
import re, sys
line = sys.stdin.readline().rstrip("\n")
m = re.match(r"^(.*\S)\s+(\d+\.\d+)\s*$", line)
if not m:
    sys.exit(1)
rest, win_pane = m.groups()
m = re.match(r"^(.*\S)\s+\d+$", rest)
if m:
    rest = m.group(1)
m = re.match(r"^(.*\S)\s+(\S+)$", rest)
if not m:
    sys.exit(1)
session, status = m.groups()
print(session)
print(win_pane)
' <<<"$selected")

if [[ -z $parsed ]]; then
  echo "Failed to parse selection."
  sleep 2
  exit 1
fi

session=$(echo "$parsed" | sed -n '1p')
win_pane=$(echo "$parsed" | sed -n '2p')

window="${win_pane%%.*}"
pane="${win_pane##*.}"

tmux switch-client -t "$session"
tmux select-window -t "${session}:${window}"
tmux select-pane -t "${session}:${window}.${pane}"
