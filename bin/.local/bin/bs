;// CONCATENATED MODULE: ../../packages/git/src/parse.ts

/**
 * Parse `git worktree list --porcelain` into entries (paths exactly as git
 * reports them; no canonicalisation).
 */ function parseWorktreeList(text) {
    const entries = [];
    let current;
    for (const line of text.split("\n")){
        if (line.startsWith("worktree ")) {
            current = {
                path: line.slice("worktree ".length).trim(),
                locked: false,
                lockReason: undefined,
                branch: undefined
            };
            entries.push(current);
        } else if (current !== undefined && line.startsWith("locked")) {
            [current.locked, current.lockReason] = parseLockedLine(line);
        } else if (current !== undefined && line.startsWith("branch ")) {
            const ref = line.slice("branch ".length).trim();
            current.branch = ref.startsWith("refs/heads/") ? ref.slice("refs/heads/".length) : ref;
        }
    // `detached` line → branch stays undefined
    }
    return entries;
}

;// CONCATENATED MODULE: ../../packages/git/src/runner.ts


/**
 * Environment variables git sets inside hooks. Inherited by children, they
 * would make our git calls operate on the *hook's* repository instead of the
 * one chosen by the working directory, so they are always removed.
 */ const HOOK_ENV_VARS = [
    "GIT_DIR",
    "GIT_INDEX_FILE",
    "GIT_OBJECT_DIRECTORY",
    "GIT_ALTERNATE_OBJECT_DIRECTORIES",
    "GIT_WORK_TREE",
    "GIT_PREFIX",
    "GIT_INTERNAL_SUPER_PREFIX",
    "GIT_COMMON_DIR"
];
/** `process.env` without hook-injected git variables. */ function cleanGitEnv(env) {
    const out = {
        ...env
    };
    for (const v of HOOK_ENV_VARS)delete out[v];
    return out;
}
/** Counting semaphore bounding concurrent git processes. */ class Semaphore {
    max;
    active = 0;
    waiters = [];
    constructor(max){
        this.max = max;
    }
    async run(task) {
        if (this.active >= this.max) {
            await new Promise((resolve)=>this.waiters.push(resolve));
        }
        this.active++;
        try {
            return await task();
        } finally{
            this.active--;
            this.waiters.shift()?.();
        }
    }
}
/** Default runner: async `execFile("git")` with a bounded process pool. */ function createExecRunner(maxConcurrency) {
    const gate = new Semaphore(maxConcurrency);
    return (args)=>gate.run(()=>new Promise((resolve, reject)=>{
                (0,external_node_child_process_namespaceObject.execFile)("git", args, {
                    env: cleanGitEnv(process.env),
                    encoding: "utf8",
                    maxBuffer: 256 * 1024 * 1024
                }, (error, stdout, stderr)=>{
                    if (error === null) {
                        resolve({
                            code: 0,
                            stdout,
                            stderr
                        });
                    } else if (typeof error.code === "number") {
                        resolve({
                            code: error.code,
                            stdout,
                            stderr
                        });
                    } else {
                        reject(new BonsaiError(`failed to spawn \`git ${args[0] ?? ""}\`: ${error.message}`));
                    }
                });
            }));
}

;// CONCATENATED MODULE: ../../packages/git/src/git.ts



function branchFlag(mode) {
    switch(mode.kind){
        case "new":
            return [
                "-b",
                mode.name
            ];
        case "reset":
            return [
                "-B",
                mode.name
            ];
        case "existing":
            return [
                mode.name
            ];
    }
}
/** Git adapter: implements the core `Git` port over the `git` CLI. */ function createGit(options = {}) {
    const run = options.runner ?? createExecRunner(options.maxConcurrency ?? 16);
    /** Run git; throw `BonsaiError("`git <what>` failed: <stderr>")` on failure. */ async function must(args, what, suffix = "") {
        const r = await run(args);
        if (r.code !== 0) {
            throw new BonsaiError(`\`${what}\` failed${suffix}: ${r.stderr.trim()}`);
        }
        return r;
    }
    /** Run `git -C <dir> …`; trimmed stdout on success, `null` otherwise. */ async function ok(dir, args) {
        try {
            const r = await run([
                "-C",
                dir,
                ...args
            ]);
            return r.code === 0 ? r.stdout.trim() : null;
        } catch  {
            return null;
        }
    }
    return {
        async revParseHeadAndCommonDir () {
            const r = await must([
                "rev-parse",
                "HEAD",
                "--git-common-dir"
            ], "git rev-parse HEAD --git-common-dir");
            const [head, commonDir] = r.stdout.split("\n").map((l)=>l.trim());
            if (head === undefined || head === "") {
                throw new BonsaiError("`git rev-parse` produced no HEAD output");
            }
            if (commonDir === undefined || commonDir === "") {
                throw new BonsaiError("`git rev-parse` produced no --git-common-dir output");
            }
            return {
                headSha: head,
                commonDir
            };
        },
        async revParseCommonDir () {
            const r = await must([
                "rev-parse",
                "--git-common-dir"
            ], "git rev-parse --git-common-dir");
            return r.stdout.trim();
        },
        async resolveHead () {
            const r = await must([
                "rev-parse",
                "HEAD"
            ], "git rev-parse HEAD");
            return r.stdout.trim();
        },
        async listWorktrees () {
            const r = await must([
                "worktree",
                "list",
                "--porcelain"
            ], "git worktree list");
            return parseWorktreeList(r.stdout);
        },
        async status (dir) {
            const r = await must([
                "-C",
                dir,
                "status",
                "--porcelain",
                "--untracked-files=all"
            ], "git status --porcelain", ` for ${dir}`);
            return parseStatusPorcelain(r.stdout);
        },
        async configGetAll (dir, key) {
            const r = await run([
                "-C",
                dir,
                "config",
                "--get-all",
                key
            ]);
            if (r.code !== 0) {
                // Exit 1 with empty stderr: key not set anywhere — not an error.
                if (r.stderr.trim() === "") return [];
                throw new BonsaiError(`\`git config --get-all ${key}\` failed: ${r.stderr.trim()}`);
            }
            return r.stdout.split("\n").filter((l)=>l !== "");
        },
        async worktreePrune () {
            await must([
                "worktree",
                "prune"
            ], "git worktree prune");
        },
        async worktreeLock (path, reason) {
            const args = reason === undefined ? [
                "worktree",
                "lock",
                path
            ] : [
                "worktree",
                "lock",
                "--reason",
                reason,
                path
            ];
            await must(args, "git worktree lock");
        },
        async worktreeUnlock (path) {
            await must([
                "worktree",
                "unlock",
                path
            ], "git worktree unlock");
        },
        async checkout (slot, headSha, branch) {
            const args = branch === undefined ? [
                "-C",
                slot,
                "checkout",
                "--detach",
                headSha
            ] : branch.kind === "existing" ? [
                "-C",
                slot,
                "checkout",
                branch.name
            ] : [
                "-C",
                slot,
                "checkout",
                ...branchFlag(branch),
                headSha
            ];
            await must(args, "git checkout");
        },
        async resetHardAndClean (slot) {
            await must([
                "-C",
                slot,
                "reset",
                "--hard"
            ], "git reset --hard");
            await must([
                "-C",
                slot,
                "clean",
                "-fd"
            ], "git clean");
        },
        async worktreeAdd (slot, headSha, branch) {
            const args = branch === undefined ? [
                "worktree",
                "add",
                "--detach",
                slot,
                headSha
            ] : branch.kind === "existing" ? [
                "worktree",
                "add",
                slot,
                branch.name
            ] : [
                "worktree",
                "add",
                ...branchFlag(branch),
                slot,
                headSha
            ];
            await must(args, "git worktree add");
        },
        // ── branch-state probes ──────────────────────────────────────────────
        symbolicRefShort: (dir, ref)=>ok(dir, [
                "symbolic-ref",
                "-q",
                "--short",
                ref
            ]),
        async refExists (dir, ref) {
            return await ok(dir, [
                "rev-parse",
                "--verify",
                "-q",
                ref
            ]) !== null;
        },
        remoteUrl: (dir, remote)=>ok(dir, [
                "remote",
                "get-url",
                remote
            ]),
        async isAncestor (dir, ancestor, descendant) {
            return await ok(dir, [
                "merge-base",
                "--is-ancestor",
                ancestor,
                descendant
            ]) !== null;
        },
        async countCommits (dir, range) {
            const out = await ok(dir, [
                "rev-list",
                "--count",
                range
            ]);
            if (out === null) return null;
            const n = Number.parseInt(out, 10);
            return Number.isNaN(n) ? null : n;
        },
        configValue: (dir, key)=>ok(dir, [
                "config",
                key
            ]),
        cherry: (dir, upstream)=>ok(dir, [
                "cherry",
                upstream,
                "HEAD"
            ]),
        async mergeTree (dir, a, b) {
            const out = await ok(dir, [
                "merge-tree",
                "--write-tree",
                a,
                b
            ]);
            if (out === null || out === "") return null;
            return out.split("\n")[0] ?? null;
        },
        treeOf: (dir, rev)=>ok(dir, [
                "rev-parse",
                `${rev}^{tree}`
            ])
    };
}

;// CONCATENATED MODULE: ../../packages/git/src/index.ts




;// CONCATENATED MODULE: ../../packages/tmux/src/tmux.ts


function spawnTmux(args, options) {
    return new Promise((resolve, reject)=>{
        const child = (0,external_node_child_process_namespaceObject.spawn)("tmux", args, options);
        let stderr = "";
        child.stderr?.on("data", (chunk)=>{
            stderr += chunk.toString("utf8");
        });
        child.on("error", reject);
        child.on("close", (code)=>resolve({
                code: code ?? 1,
                stderr
            }));
    });
}
const nodeProcess = {
    capture: (args)=>spawnTmux(args, {
            stdio: [
                "ignore",
                "ignore",
                "pipe"
            ]
        }),
    inherit: async (args)=>(await spawnTmux(args, {
            stdio: "inherit"
        })).code
};
/**
 * tmux adapter: implements the core `Tmux` port.
 *
 * When `BONSAI_TMUX_SOCKET` is set every invocation is pinned to that socket
 * via `-L <name>`, so tests can exercise real session creation against a
 * throwaway server instead of the user's real tmux server.
 */ function createTmux(options = {}) {
    const env = options.env ?? process.env;
    const proc = options.process ?? nodeProcess;
    const socketArgs = ()=>{
        const socket = env.BONSAI_TMUX_SOCKET;
        return socket === undefined ? [] : [
            "-L",
            socket
        ];
    };
    return {
        async checkAvailable () {
            try {
                await proc.capture([
                    ...socketArgs(),
                    "-V"
                ]);
            } catch (e) {
                if (e.code === "ENOENT") {
                    throw new BonsaiError("tmux was not found on PATH; install tmux to use --tmux-session, or omit the flag to skip tmux integration");
                }
                throw new BonsaiError(`failed to check for \`tmux\` on PATH: ${e.message}`);
            }
        },
        async hasSession (name) {
            try {
                const r = await proc.capture([
                    ...socketArgs(),
                    "has-session",
                    "-t",
                    name
                ]);
                return r.code === 0;
            } catch (e) {
                throw new BonsaiError(`failed to spawn \`tmux has-session\`: ${e.message}`);
            }
        },
        async newSession (name, cwd) {
            let r;
            try {
                r = await proc.capture([
                    ...socketArgs(),
                    "new-session",
                    "-d",
                    "-s",
                    name,
                    "-c",
                    cwd
                ]);
            } catch (e) {
                throw new BonsaiError(`failed to spawn \`tmux new-session\`: ${e.message}`);
            }
            if (r.code !== 0) {
                throw new BonsaiError(`\`tmux new-session\` failed: ${r.stderr.trim()}`);
            }
        },
        async attach (name) {
            // Inside a tmux client `attach-session` would fail; switch instead.
            const insideTmux = env.TMUX !== undefined;
            const args = insideTmux ? [
                "switch-client",
                "-t",
                name
            ] : [
                "attach-session",
                "-t",
                name
            ];
            let code;
            try {
                code = await proc.inherit([
                    ...socketArgs(),
                    ...args
                ]);
            } catch (e) {
                throw new BonsaiError(`failed to spawn \`tmux switch-client\`/\`tmux attach-session\`: ${e.message}`);
            }
            if (code !== 0) {
                throw new BonsaiError(`failed to attach to tmux session \`${name}\``);
            }
        }
    };
}

;// CONCATENATED MODULE: ../../packages/tmux/src/index.ts


;// CONCATENATED MODULE: ./src/runtime.ts
/** Composition root: wires the core ports to their adapters. */ 





const nodeFs = {
    async exists (path) {
        try {
            await (0,promises_namespaceObject.stat)(path);
            return true;
        } catch  {
            return false;
        }
    },
    realpath: (path)=>(0,promises_namespaceObject.realpath)(path),
    async mkdirp (path) {
        await (0,promises_namespaceObject.mkdir)(path, {
            recursive: true
        });
    },
    copyFile: (src, dest)=>(0,promises_namespaceObject.copyFile)(src, dest),
    removeDir: (path)=>(0,promises_namespaceObject.rm)(path, {
            recursive: true
        })
};
const nodeEnv = {
    cwd: ()=>process.cwd(),
    get: (name)=>process.env[name],
    homeDir: ()=>(0,external_node_os_.homedir)() || undefined,
    randomSlotId: ()=>(0,external_node_crypto_namespaceObject.randomUUID)().slice(0, 8)
};
const createRuntime = ({ logLevel })=>{
    const logging = createLogging({
        level: logLevel
    });
    return {
        deps: {
            git: createGit(),
            fs: nodeFs,
            env: nodeEnv,
            log: logging.logger
        },
        tmux: createTmux(),
        logs: createLogLocation(),
        close: ()=>logging.close()
    };
};

