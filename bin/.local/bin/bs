;// CONCATENATED MODULE: ../../packages/core/src/errors.ts
/** An expected, user-facing failure. The CLI prints its message and exits 1. */ class BonsaiError extends Error {
    name = "BonsaiError";
}
/** Message of any thrown value. */ function errorMessage(e) {
    return e instanceof Error ? e.message : String(e);
}

;// CONCATENATED MODULE: ../../packages/core/src/branch-state.ts
/**
 * Branch-state check: does a clean slot's branch carry unmerged work?
 *
 * Uses only local git state (refs, config, objects): no network, no fetch.
 * Whenever merged-ness cannot be proven the answer errs toward "unmerged"
 * (the slot is `in use`).
 */ /** `true` when resetting the slot cannot lose work. */ function isAvailable(state) {
    return state.kind === "no-own-commits" || state.kind === "merged-remote-gone";
}
function commits(n) {
    return n === 1 ? "1 commit" : `${n} commits`;
}
/** Human-readable reason, relative to `defaultRef`. */ function branch_state_reason(state, defaultRef) {
    const d = defaultRef ?? "the default branch";
    switch(state.kind){
        case "no-own-commits":
            return "no commits of its own";
        case "merged-remote-gone":
            return `merged into ${d}, remote branch is gone`;
        case "unpushed":
            return `${commits(state.n)} ahead of ${d}, no upstream configured (push with \`-u\` to enable merged-branch detection)`;
        case "remote-exists":
            return `${commits(state.n)} ahead of ${d}, remote branch still exists`;
        case "not-merged":
            return `${commits(state.n)} ahead of ${d}, not merged`;
        case "detached-with-commits":
            return `detached HEAD with ${commits(state.n)} not on ${d}`;
        case "default-unknown":
            return "default branch could not be determined";
    }
}
/**
 * Resolve the default ref once: `origin/HEAD`, else `origin/main`,
 * `origin/master`; local `main`/`master` only when there is no `origin`.
 */ async function resolveDefaultRef(git, dir) {
    const head = await git.symbolicRefShort(dir, "refs/remotes/origin/HEAD");
    if (head !== null && head !== "" && await git.refExists(dir, head)) {
        return head;
    }
    for (const c of [
        "origin/main",
        "origin/master"
    ]){
        if (await git.refExists(dir, `refs/remotes/${c}`)) return c;
    }
    if (await git.remoteUrl(dir, "origin") === null) {
        for (const c of [
            "main",
            "master"
        ]){
            if (await git.refExists(dir, `refs/heads/${c}`)) return c;
        }
    }
    return undefined;
}
/**
 * A default ref resolved at most once, on first use, and shareable across
 * concurrent per-slot checks (locked/dirty slots never pay for resolution).
 */ class LazyDefaultRef {
    git;
    dir;
    pending;
    constructor(git, dir){
        this.git = git;
        this.dir = dir;
    }
    get() {
        this.pending ??= resolveDefaultRef(this.git, this.dir);
        return this.pending;
    }
}
/** Is the branch's content already on `d`? (cherry for rebase, merge-tree for squash) */ async function contentOnDefault(git, slot, d) {
    const cherry = await git.cherry(slot, d);
    if (cherry !== null && !cherry.split("\n").some((l)=>l.startsWith("+"))) {
        return true;
    }
    const resultTree = await git.mergeTree(slot, d, "HEAD");
    if (resultTree === null) return false;
    return await git.treeOf(slot, d) === resultTree;
}
/**
 * Evaluate the branch state of `slot` (checked-out `branch`, `undefined` if
 * detached), cheapest check first with early return.
 */ async function branchState(git, slot, branch, defaultRef) {
    if (defaultRef === undefined) return {
        kind: "default-unknown"
    };
    const d = defaultRef;
    if (await git.isAncestor(slot, "HEAD", d)) return {
        kind: "no-own-commits"
    };
    const n = await git.countCommits(slot, `${d}..HEAD`) ?? 0;
    if (branch === undefined) return {
        kind: "detached-with-commits",
        n
    };
    const remote = await git.configValue(slot, `branch.${branch}.remote`);
    const merge = await git.configValue(slot, `branch.${branch}.merge`);
    if (remote === null || merge === null) return {
        kind: "unpushed",
        n
    };
    if (remote === "." || remote === "" || merge === "") {
        return {
            kind: "unpushed",
            n
        };
    }
    const mergeBranch = merge.startsWith("refs/heads/") ? merge.slice("refs/heads/".length) : merge;
    if (await git.refExists(slot, `refs/remotes/${remote}/${mergeBranch}`)) {
        return {
            kind: "remote-exists",
            n
        };
    }
    return await contentOnDefault(git, slot, d) ? {
        kind: "merged-remote-gone"
    } : {
        kind: "not-merged",
        n
    };
}

;// CONCATENATED MODULE: ../../packages/core/src/classify.ts
/**
 * Classify a slot given its lock state, dirty state, and whether its branch
 * carries unmerged work. Priority: `locked` > `in use` > `available`.
 *
 * This is the single place the priority rule is encoded; list, status, prune
 * and get all route through it so the commands can never disagree.
 */ function classify(locked, dirty, hasUnmergedWork) {
    if (locked) return "locked";
    if (dirty || hasUnmergedWork) return "in use";
    return "available";
}
/** Lower-case ASCII slug: every non-alphanumeric character becomes `-`. */ function slugify(name) {
    let out = "";
    for (const ch of name){
        out += /^[A-Za-z0-9]$/.test(ch) ? ch.toLowerCase() : "-";
    }
    return out;
}
/**
 * Parse a `locked` line from `git worktree list --porcelain`: `locked` or
 * `locked <reason>`. Returns `[isLocked, reason]`.
 */ function parseLockedLine(line) {
    if (!line.startsWith("locked")) return [
        false,
        undefined
    ];
    const reason = line.slice("locked".length).trim();
    return [
        true,
        reason === "" ? undefined : reason
    ];
}
/**
 * Split `git status --porcelain` text into uncommitted (non-`??`) and
 * untracked (`??`) lines.
 */ function parseStatusPorcelain(text) {
    const detail = {
        uncommitted: [],
        untracked: []
    };
    for (const line of text.split("\n")){
        if (line === "") continue;
        const entry = line.length >= 3 ? {
            code: line.slice(0, 2),
            path: line.slice(3)
        } : line.length >= 2 ? {
            code: line.slice(0, 2),
            path: ""
        } : {
            code: line,
            path: ""
        };
        (entry.code === "??" ? detail.untracked : detail.uncommitted).push(entry);
    }
    return detail;
}

;// CONCATENATED MODULE: ../../packages/core/src/path.ts
/**
 * Minimal, pure POSIX path helpers. Core must not import `node:path`, and
 * bonsai only supports POSIX paths.
 */ function isAbsolute(p) {
    return p.startsWith("/");
}
/** Resolve `p` against `base` (when relative) and normalise `.`/`..`/`//`. */ function path_resolve(base, p) {
    const full = isAbsolute(p) ? p : `${base}/${p}`;
    const out = [];
    for (const part of full.split("/")){
        if (part === "" || part === ".") continue;
        if (part === "..") out.pop();
        else out.push(part);
    }
    return `/${out.join("/")}`;
}
/** Join path segments with `/` (no normalisation, like Rust's `Path::join`). */ function join(base, ...parts) {
    let out = base;
    for (const part of parts){
        if (isAbsolute(part)) out = part;
        else out = out.endsWith("/") ? `${out}${part}` : `${out}/${part}`;
    }
    return out;
}
/** Parent directory, or `undefined` for the root / an empty path. */ function dirname(p) {
    const trimmed = p.length > 1 ? p.replace(/\/+$/, "") : p;
    if (trimmed === "/" || trimmed === "") return undefined;
    const idx = trimmed.lastIndexOf("/");
    if (idx < 0) return "";
    return idx === 0 ? "/" : trimmed.slice(0, idx);
}
/** Final path component, or `undefined` when there is none (e.g. `/`). */ function path_basename(p) {
    const trimmed = p.replace(/\/+$/, "");
    if (trimmed === "") return undefined;
    const name = trimmed.slice(trimmed.lastIndexOf("/") + 1);
    return name === "" || name === ".." ? undefined : name;
}
/** Component-wise prefix test (`/a/bc` does not start with `/a/b`). */ function startsWith(p, prefix) {
    if (p === prefix) return true;
    const base = prefix.endsWith("/") ? prefix : `${prefix}/`;
    return p.startsWith(base);
}
/** Replace a leading `home` with `~` (exactly `home` becomes `~/`). */ function tildePath(p, home) {
    if (home !== undefined && home !== "") {
        if (p === home) return "~/";
        if (startsWith(p, home)) {
            const rest = p.slice(home.endsWith("/") ? home.length : home.length + 1);
            return `~/${rest}`;
        }
    }
    return p;
}

;// CONCATENATED MODULE: ../../packages/core/src/pool.ts
/**
 * Managed git-worktree pool logic.
 *
 * Pool layout:
 *
 *     <managed_root>/
 *       <repo-slug>/          <- derived from the main repo root basename
 *         <8-hex-id>/         <- one slot per managed worktree
 */ 



const BARE_REPO_MESSAGE = "bare repositories are not supported by `bs get`; run from a non-bare working tree";
/** Canonicalise `p`, falling back to `p` itself when it cannot be resolved. */ async function canonicalOr(deps, p) {
    try {
        return await deps.fs.realpath(p);
    } catch  {
        return p;
    }
}
/** Turn git's (possibly relative) common dir into an absolute path. */ function absoluteCommonDir(deps, raw) {
    if (raw === ".") throw new BonsaiError(BARE_REPO_MESSAGE);
    return path_resolve(deps.env.cwd(), raw);
}
/** Repo slug (basename of the main repo root) for a git common dir. */ function slugFromCommonDir(commonDir) {
    const repoRoot = dirname(commonDir);
    if (repoRoot === undefined) {
        throw new BonsaiError("`git common dir` path has no parent component");
    }
    const basename = path_basename(repoRoot);
    if (basename === undefined) {
        throw new BonsaiError("repo root directory has no usable file name");
    }
    return slugify(basename);
}
/** Basename of the **main** repo root, slugified; same from any worktree. */ async function repoSlug(deps) {
    const raw = await deps.git.revParseCommonDir();
    return slugFromCommonDir(absoluteCommonDir(deps, raw));
}
/** `$BONSAI_ROOT` when set, otherwise `~/.bonsai`. */ function managedRoot(deps) {
    const root = deps.env.get("BONSAI_ROOT");
    if (root !== undefined) return root;
    const home = deps.env.homeDir();
    if (home === undefined) {
        throw new BonsaiError("cannot resolve the home directory; please ensure the $HOME environment variable is set");
    }
    return join(home, ".bonsai");
}
/** `~`-abbreviated path for display. */ function pool_tilde(deps, p) {
    return tildePath(p, deps.env.homeDir());
}
async function poolDirFor(deps) {
    return join(managedRoot(deps), await repoSlug(deps));
}
// ── pool scan ──────────────────────────────────────────────────────────────
/**
 * Pool entries (canonicalised, under `poolDir`) plus a stale flag: `true`
 * when ANY registered worktree path no longer exists on disk, i.e. a
 * `git worktree prune` is warranted.
 */ async function listPoolWorktreesCheckingStale(deps, poolDir) {
    const raw = await deps.git.listWorktrees();
    // Canonicalise once so comparisons hold through symlinks (/tmp → /private/tmp).
    const poolCanonical = await canonicalOr(deps, poolDir);
    const entries = [];
    let hasStale = false;
    for (const entry of raw){
        const canonical = await canonicalOr(deps, entry.path);
        if (!await deps.fs.exists(canonical)) hasStale = true;
        if (startsWith(canonical, poolCanonical)) {
            entries.push({
                ...entry,
                path: canonical
            });
        }
    }
    return {
        entries,
        hasStale
    };
}
/** Registered worktrees whose path falls under `poolDir`. */ async function listPoolWorktrees(deps, poolDir) {
    return (await listPoolWorktreesCheckingStale(deps, poolDir)).entries;
}
/**
 * Classify one pool slot, short-circuiting as soon as the classification is
 * known so cheaper signals are checked first: locked (free) → dirty (one
 * `git status`) → branch state.
 */ async function classifySlotStatus(deps, entry, defaultRef) {
    if (entry.locked) return classify(true, false, false);
    const status = await deps.git.status(entry.path);
    if (status.uncommitted.length > 0 || status.untracked.length > 0) {
        return classify(false, true, false);
    }
    const state = await branchState(deps.git, entry.path, entry.branch, await defaultRef.get());
    return classify(false, false, !isAvailable(state));
}
/**
 * Status of every pool slot. Per-slot checks run concurrently (the git
 * adapter bounds actual process parallelism); original order is preserved.
 */ async function listWorktreesStatus(deps, poolDir) {
    const entries = await listPoolWorktrees(deps, poolDir);
    const defaultRef = new LazyDefaultRef(deps.git, ".");
    return Promise.all(entries.map(async (entry)=>{
        const status = await deps.fs.exists(entry.path) ? await classifySlotStatus(deps, entry, defaultRef) : "in use";
        return {
            path: entry.path,
            status,
            branch: entry.branch
        };
    }));
}
/** `bs list` data. `undefined` when the pool does not exist yet. */ async function listPool(deps) {
    const poolDir = await poolDirFor(deps);
    if (!await deps.fs.exists(poolDir)) return undefined;
    const entries = await listWorktreesStatus(deps, poolDir);
    // Detect the current slot once; tolerate errors (treat as none).
    const current = await currentWorktree(deps).then((c)=>c?.path, ()=>undefined);
    return {
        entries,
        current
    };
}
/** Detailed status report for a single registered pool slot. */ async function slotStatus(deps, slot) {
    let canonical;
    try {
        canonical = await deps.fs.realpath(slot);
    } catch (e) {
        throw new BonsaiError(`failed to canonicalize slot path ${slot}: ${errorMessage(e)}`);
    }
    // Scoping the "pool" filter to the slot's own path means only this one
    // worktree entry (if any) passes the prefix check.
    const { entries } = await listPoolWorktreesCheckingStale(deps, canonical);
    const entry = entries.find((e)=>e.path === canonical);
    if (entry === undefined) {
        throw new BonsaiError(`${canonical} is not a registered git worktree`);
    }
    const gitStatus = await deps.git.status(canonical);
    const dirty = gitStatus.uncommitted.length > 0 || gitStatus.untracked.length > 0;
    let hasUnmergedWork = false;
    let branchStateReason;
    if (!entry.locked) {
        const defaultRef = await resolveDefaultRef(deps.git, canonical);
        const state = await branchState(deps.git, canonical, entry.branch, defaultRef);
        hasUnmergedWork = !isAvailable(state);
        branchStateReason = branch_state_reason(state, defaultRef);
    }
    return {
        path: canonical,
        branch: entry.branch,
        status: classify(entry.locked, dirty, hasUnmergedWork),
        lockReason: entry.lockReason,
        branchState: branchStateReason,
        gitStatus
    };
}
// ── slot selection & provisioning ──────────────────────────────────────────
/** First available (clean, unlocked, on-disk, no unmerged work) slot. */ async function findAvailableSlot(deps, poolDir) {
    const { entries, hasStale } = await listPoolWorktreesCheckingStale(deps, poolDir);
    if (hasStale) {
        deps.log.info("Pruning stale worktrees from pool");
        await deps.git.worktreePrune();
    }
    const defaultRef = new LazyDefaultRef(deps.git, ".");
    for (const entry of entries){
        if (entry.locked || !await deps.fs.exists(entry.path)) continue;
        if (await classifySlotStatus(deps, entry, defaultRef) !== "available") {
            continue;
        }
        deps.log.info(`Found available slot: ${entry.path}`);
        return entry.path;
    }
    deps.log.debug("No available slots found in pool");
    return undefined;
}
function describeBranch(branch) {
    if (branch === undefined) return "detached HEAD";
    const label = {
        new: "new",
        reset: "reset",
        existing: "existing"
    }[branch.kind];
    return `${label} branch ${branch.name}`;
}
/** Reset an existing slot to `headSha`, optionally checking out a branch. */ async function resetSlot(deps, slot, headSha, branch) {
    deps.log.debug(`Resetting slot ${slot} to ${headSha} (${describeBranch(branch)})`);
    try {
        await deps.git.checkout(slot, headSha, branch);
    } catch (e) {
        deps.log.warn(`git checkout failed for slot ${slot}: ${errorMessage(e)}`);
        throw e;
    }
    deps.log.debug(`Successfully reset slot ${slot}`);
}
/** The first pool slot currently checked out on `branch`, if any. */ async function findSlotCheckedOutOnBranch(deps, poolDir, branch) {
    if (!await deps.fs.exists(poolDir)) return undefined;
    const entries = await listPoolWorktrees(deps, poolDir);
    return entries.find((e)=>e.branch === branch)?.path;
}
/** Copy each relative `entries` path from `originRoot` into `slot`. */ async function copyIgnoredFiles(deps, originRoot, slot, entries) {
    let copied = 0;
    let skipped = 0;
    for (const entry of entries){
        const source = join(originRoot, entry);
        if (!await deps.fs.exists(source)) {
            deps.log.debug(`bonsai.copy: skipping missing source file ${source}`);
            skipped++;
            continue;
        }
        const dest = join(slot, entry);
        const parent = dirname(dest);
        if (parent !== undefined && parent !== "") {
            try {
                await deps.fs.mkdirp(parent);
            } catch (e) {
                throw new BonsaiError(`failed to create destination directory ${parent}: ${errorMessage(e)}`);
            }
        }
        try {
            await deps.fs.copyFile(source, dest);
        } catch (e) {
            throw new BonsaiError(`failed to copy ${source} to ${dest}: ${errorMessage(e)}`);
        }
        copied++;
    }
    if (copied > 0 || skipped > 0) {
        deps.log.info(`bonsai.copy: copied ${copied} file(s), skipped ${skipped} missing entry(ies) into ${slot}`);
    }
}
/**
 * Full `get` flow: provision (or reuse) a slot and return its canonical
 * path. With no `branch` the slot is left in detached HEAD.
 */ async function getWorktree(deps, branch) {
    // The origin worktree: source root for `bonsai.copy` entries and the
    // directory `git config --get-all bonsai.copy` is resolved from.
    const originDir = deps.env.cwd();
    const { headSha, commonDir: rawCommonDir } = await deps.git.revParseHeadAndCommonDir();
    const slug = slugFromCommonDir(absoluteCommonDir(deps, rawCommonDir));
    let poolDir = join(managedRoot(deps), slug);
    try {
        await deps.fs.mkdirp(poolDir);
        poolDir = await deps.fs.realpath(poolDir);
    } catch (e) {
        throw new BonsaiError(`failed to create pool directory ${poolDir}: ${errorMessage(e)}`);
    }
    // For a positional `<branch>`, first check whether one of this repo's
    // managed slots already has it checked out; if so hand that slot back
    // (git would refuse to check the branch out a second time).
    if (branch?.kind === "existing") {
        const existing = await findSlotCheckedOutOnBranch(deps, poolDir, branch.name);
        if (existing !== undefined) return deps.fs.realpath(existing);
    }
    let slot = await findAvailableSlot(deps, poolDir);
    if (slot !== undefined) {
        await resetSlot(deps, slot, headSha, branch);
    } else {
        slot = join(poolDir, deps.env.randomSlotId());
        await deps.git.worktreeAdd(slot, headSha, branch);
    }
    // Final provisioning step: copy `bonsai.copy` files from the origin.
    const copyEntries = await deps.git.configGetAll(originDir, "bonsai.copy");
    if (copyEntries.length > 0) {
        await copyIgnoredFiles(deps, originDir, slot, copyEntries);
    }
    return deps.fs.realpath(slot);
}
// ── current slot ───────────────────────────────────────────────────────────
/** The managed slot containing the CWD, or `undefined`. */ async function currentWorktree(deps) {
    let cwd;
    try {
        cwd = await deps.fs.realpath(deps.env.cwd());
    } catch (e) {
        throw new BonsaiError(`failed to canonicalize current directory: ${errorMessage(e)}`);
    }
    const poolDir = await poolDirFor(deps);
    if (!await deps.fs.exists(poolDir)) return undefined;
    const poolCanonical = await canonicalOr(deps, poolDir);
    const entries = await listPoolWorktrees(deps, poolCanonical);
    const hit = entries.find((e)=>startsWith(cwd, e.path));
    return hit === undefined ? undefined : {
        path: hit.path,
        branch: hit.branch
    };
}
/** Resolve an explicit path argument or fall back to the current slot. */ async function resolveTargetSlot(deps, explicit) {
    if (explicit !== undefined) return explicit;
    const current = await currentWorktree(deps);
    if (current === undefined) {
        throw new BonsaiError("not inside a managed bonsai pool slot; please provide a path argument");
    }
    return current.path;
}
/** Verify `slot` exists and lies under this repo's pool directory. */ async function validatePoolSlot(deps, slot, poolDir) {
    if (!await deps.fs.exists(slot)) {
        throw new BonsaiError(`path does not exist: ${slot}`);
    }
    const poolCanonical = await canonicalOr(deps, poolDir);
    const slotCanonical = await canonicalOr(deps, slot);
    if (!startsWith(slotCanonical, poolCanonical)) {
        throw new BonsaiError(`${slot} is not a bonsai-managed pool slot (pool directory: ${poolDir})`);
    }
}
// ── status / lock / unlock use cases ───────────────────────────────────────
/** `bs status [PATH]` data. */ async function statusForPath(deps, explicit) {
    const poolDir = await poolDirFor(deps);
    const target = await resolveTargetSlot(deps, explicit);
    await validatePoolSlot(deps, target, poolDir);
    return slotStatus(deps, target);
}
/** `bs lock [PATH]`; returns the locked path. */ async function lockSlot(deps, explicit, reason) {
    const poolDir = await poolDirFor(deps);
    const target = await resolveTargetSlot(deps, explicit);
    await validatePoolSlot(deps, target, poolDir);
    deps.log.info(reason === undefined ? `Locking slot ${target}` : `Locking slot ${target} with reason: ${reason}`);
    try {
        await deps.git.worktreeLock(target, reason);
    } catch (e) {
        deps.log.warn(`Failed to lock slot ${target}: ${errorMessage(e)}`);
        throw e;
    }
    deps.log.debug(`Successfully locked slot ${target}`);
    return target;
}
/** `bs unlock [PATH]`; returns the unlocked path. */ async function unlockSlot(deps, explicit) {
    const poolDir = await poolDirFor(deps);
    const target = await resolveTargetSlot(deps, explicit);
    await validatePoolSlot(deps, target, poolDir);
    deps.log.info(`Unlocking slot ${target}`);
    try {
        await deps.git.worktreeUnlock(target);
    } catch (e) {
        deps.log.warn(`Failed to unlock slot ${target}: ${errorMessage(e)}`);
        throw e;
    }
    deps.log.debug(`Successfully unlocked slot ${target}`);
    return target;
}
/**
 * Validate explicit prune targets and return the candidate entries (in pool
 * order). Throws one aggregated error, before anything is touched.
 */ async function resolvePruneTargets(deps, all, paths, force) {
    const canon = new Map();
    for (const e of all)canon.set(await canonicalOr(deps, e.path), e);
    const targeted = new Set();
    const errors = [];
    for (const raw of paths){
        const abs = path_resolve(deps.env.cwd(), raw);
        const entry = canon.get(await canonicalOr(deps, abs));
        if (entry === undefined) {
            errors.push(`${raw} is not a bonsai-managed pool slot`);
        } else if (entry.status === "locked") {
            errors.push(`${raw} is locked; unlock it first (\`bs unlock\`) before pruning`);
        } else if (entry.status === "in use" && !force) {
            errors.push(`${raw} is in use; pass --force to prune it`);
        } else {
            targeted.add(entry);
        }
    }
    if (errors.length > 0) throw new BonsaiError(errors.join("\n"));
    return all.filter((e)=>targeted.has(e));
}
/**
 * Prune the pool: bring eligible slots to `available`, keep exactly one
 * available slot (detached / sanitized as needed), delete the other eligible
 * slots' directories, then run `git worktree prune` once. `locked` slots are
 * never touched.
 *
 * Returns `undefined` when the pool directory does not exist. Individual
 * deletion/detach failures are captured in the outcome, not thrown; invalid
 * targets throw before anything is changed.
 */ async function prunePool(deps, options = {}) {
    const force = options.force ?? false;
    const paths = options.paths ?? [];
    const poolDir = await poolDirFor(deps);
    if (!await deps.fs.exists(poolDir)) return undefined;
    const all = await listWorktreesStatus(deps, poolDir);
    const targeted = paths.length > 0;
    const candidates = targeted ? await resolvePruneTargets(deps, all, paths, force) : all.filter((e)=>e.status !== "locked");
    const isCandidate = new Set(candidates);
    const eligible = candidates.filter((e)=>e.status === "available" || force && e.status === "in use");
    // Preserved slot: untargeted available > available candidate > forced
    // in-use candidate (only one that exists on disk).
    let preserved = all.find((e)=>e.status === "available" && !isCandidate.has(e));
    const untouched = preserved !== undefined;
    preserved ??= eligible.find((e)=>e.status === "available");
    if (preserved === undefined && force) {
        for (const e of eligible){
            if (await deps.fs.exists(e.path)) {
                preserved = e;
                break;
            }
        }
    }
    const toDelete = eligible.filter((e)=>e !== preserved);
    const outcome = {
        pruned: [],
        failures: [],
        preserved: undefined,
        preserveFailure: undefined
    };
    if (preserved !== undefined) {
        const slot = {
            path: preserved.path,
            branch: preserved.branch
        };
        const needsSanitize = !untouched && preserved.status === "in use";
        if (untouched || preserved.branch === undefined && !needsSanitize) {
            outcome.preserved = slot;
        } else {
            try {
                if (needsSanitize) await deps.git.resetHardAndClean(preserved.path);
                const headSha = await deps.git.resolveHead();
                await resetSlot(deps, preserved.path, headSha, undefined);
                outcome.preserved = slot;
            } catch (e) {
                outcome.preserveFailure = {
                    path: preserved.path,
                    error: errorMessage(e)
                };
            }
        }
    }
    for (const entry of toDelete){
        try {
            await deps.fs.removeDir(entry.path);
            outcome.pruned.push({
                path: entry.path,
                branch: entry.branch
            });
        } catch (e) {
            outcome.failures.push({
                path: entry.path,
                error: `failed to delete slot directory ${entry.path}: ${errorMessage(e)}`
            });
        }
    }
    await deps.git.worktreePrune();
    return outcome;
}
/** `bs info` data: resolved paths and metadata, with no filesystem writes. */ function getInfo(deps, logs, meta) {
    const logDir = logs.dir();
    if (logDir === undefined) {
        throw new BonsaiError("Failed to resolve log directory");
    }
    return {
        version: meta.version,
        logLevel: meta.logLevel,
        logDirectory: pool_tilde(deps, logDir),
        currentLogFile: pool_tilde(deps, logs.currentFile(logDir)),
        managedRoot: pool_tilde(deps, managedRoot(deps))
    };
}


;// CONCATENATED MODULE: ../../packages/core/src/tmux.ts
/** The literal branch-display label used when no branch was requested. */ const DETACHED_LABEL = "detached";
/** Default tmux session name: `🌳 <repo-name> (<branch-display>)`. */ function defaultSessionName(repoName, branchDisplay) {
    return `\u{1f333} ${repoName} (${branchDisplay})`;
}
/**
 * Resolve the session name for `--tmux-session`. An empty value (the bare
 * flag sentinel) derives the default name; anything else is used verbatim.
 */ function resolveSessionName(value, repoName, branchDisplay) {
    return value === "" ? defaultSessionName(repoName, branchDisplay) : value;
}
/** Create a detached session rooted at `cwd`, unless it already exists. */ async function ensureSession(tmux, log, name, cwd) {
    if (await tmux.hasSession(name)) {
        log.debug(`Reusing existing tmux session ${name}`);
        return;
    }
    log.info(`Creating tmux session ${name} at ${cwd}`);
    await tmux.newSession(name, cwd);
}

