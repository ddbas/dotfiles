;// CONCATENATED MODULE: ../../packages/logging/src/paths.ts


function systemEnv() {
    return {
        platform: process.platform,
        env: process.env,
        home: (0,external_node_os_.homedir)()
    };
}
function absoluteOrUndefined(p) {
    return p?.startsWith("/") ? p : undefined;
}
/**
 * Resolve the platform log directory (`…/bonsai/logs`) without any I/O.
 *
 * Mirrors the previous implementation: the XDG state dir (`$XDG_STATE_HOME`
 * or `~/.local/state`) on Linux, otherwise the local data dir
 * (`~/Library/Application Support` on macOS, `$XDG_DATA_HOME` or
 * `~/.local/share` elsewhere).
 */ function paths_logDir(sys = systemEnv()) {
    const { platform, env, home } = sys;
    let base;
    if (platform === "linux") {
        base = absoluteOrUndefined(env.XDG_STATE_HOME) ?? (home ? (0,external_node_path_.join)(home, ".local", "state") : undefined);
    } else if (platform === "darwin") {
        base = home ? (0,external_node_path_.join)(home, "Library", "Application Support") : undefined;
    } else {
        base = absoluteOrUndefined(env.XDG_DATA_HOME) ?? (home ? (0,external_node_path_.join)(home, ".local", "share") : undefined);
    }
    return base === undefined ? undefined : (0,external_node_path_.join)(base, "bonsai", "logs");
}
/** `bonsai.log.YYYY-MM-DD` (local date) inside `dir`. No I/O. */ function currentLogFile(dir, now = new Date()) {
    const y = String(now.getFullYear()).padStart(4, "0");
    const m = String(now.getMonth() + 1).padStart(2, "0");
    const d = String(now.getDate()).padStart(2, "0");
    return (0,external_node_path_.join)(dir, `bonsai.log.${y}-${m}-${d}`);
}
/** The `LogLocation` port backed by the platform paths above. */ function createLogLocation(sys) {
    return {
        dir: ()=>paths_logDir(sys),
        currentFile: (dir)=>currentLogFile(dir)
    };
}

;// CONCATENATED MODULE: ../../packages/logging/src/logger.ts




const LOG_LEVELS = [
    "trace",
    "debug",
    "info",
    "warn",
    "error"
];
function isLogLevel(value) {
    return LOG_LEVELS.includes(value);
}
/** Number of daily log files kept in the log directory. */ const LOG_RETENTION = 7;
/** Keep only the `retention` most recently modified `bonsai.log.*` files. */ function pruneLogs(dir, retention) {
    let names;
    try {
        names = (0,external_node_fs_.readdirSync)(dir);
    } catch  {
        return;
    }
    const files = [];
    for (const name of names){
        if (!name.startsWith("bonsai.log.")) continue;
        const path = (0,external_node_path_.join)(dir, name);
        try {
            files.push({
                path,
                mtime: (0,external_node_fs_.statSync)(path).mtimeMs
            });
        } catch  {
        // vanished or unreadable: skip
        }
    }
    files.sort((a, b)=>b.mtime - a.mtime);
    for (const file of files.slice(retention)){
        try {
            (0,external_node_fs_.rmSync)(file.path);
        } catch  {
        // best-effort
        }
    }
}
const NOOP_LOGGER = {
    debug () {},
    info () {},
    warn () {},
    error () {}
};
/**
 * Set up pino logging to a daily log file in the platform log directory.
 *
 * Best-effort: if the directory cannot be created or the file opened, a
 * no-op logger is returned and the CLI proceeds without file logging.
 * Nothing is ever written to stdout/stderr.
 */ function createLogging(options) {
    const dir = options.dir ?? paths_logDir();
    if (dir === undefined) return {
        logger: NOOP_LOGGER,
        close () {}
    };
    try {
        (0,external_node_fs_.mkdirSync)(dir, {
            recursive: true
        });
        pruneLogs(dir, LOG_RETENTION);
        const destination = pino_default().destination({
            dest: currentLogFile(dir),
            sync: true,
            append: true
        });
        const base = pino_default()({
            level: options.level,
            base: null,
            timestamp: (pino_default()).stdTimeFunctions.isoTime,
            formatters: {
                level: (label)=>({
                        level: label
                    })
            }
        }, destination);
        return {
            logger: {
                debug: (m)=>base.debug(m),
                info: (m)=>base.info(m),
                warn: (m)=>base.warn(m),
                error: (m)=>base.error(m)
            },
            close: ()=>destination.flushSync()
        };
    } catch  {
        return {
            logger: NOOP_LOGGER,
            close () {}
        };
    }
}

