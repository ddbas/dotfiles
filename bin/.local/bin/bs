        version,
        runtime: createRuntime,
        io: processIo
    });
    try {
        await bs.program.parseAsync(process.argv);
    } finally{
        bs.close();
    }
    process.exitCode = bs.exitCode();
}
main().catch((e)=>{
    process.stderr.write(`error: ${e instanceof Error ? e.message : String(e)}\n`);
    process.exitCode = 1;
});


