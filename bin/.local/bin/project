#!/usr/bin/env bash

repo_dir=${REPO_DIR:-$HOME/repos}

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(fd --exact-depth=1 --type=d -L --format {/} . $repo_dir | fzf \
    --prompt="🗂️  Project: " \
    --no-sort \
    --layout=reverse \
    --border=rounded \
    --border-label=" Open project ")
fi

if [[ -z $selected ]]; then
  exit 1
fi

session_name="🗂️  $selected"

tmux_running=$(pgrep tmux)
if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
  tmux new-session -s "$session_name" -c $repo_dir/$selected
  exit 0
fi

previous_dir=$(pwd)
previous_session=$(tmux display-message -p '#S')
if ! tmux has-session -t="$session_name" 2>/dev/null; then
  tmux new-session -ds "$session_name" -c $repo_dir/$selected
fi

tmux switch-client -t "$session_name"

if [[ $previous_dir == $HOME ]]; then
  tmux kill-session -t $previous_session
fi
