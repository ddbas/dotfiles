#!/usr/bin/env bash

repo_dir=${REPO_DIR:-$HOME/repos}

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(fd --exact-depth=1 --type=d -L --format {/} . $repo_dir | fzf \
    --prompt="🗂️  Project: " \
    --layout=reverse \
    --border=rounded \
    --border-label=" Open project ")
fi

if [[ -z $selected ]]; then
  exit 1
fi

session_name="🗂️  $selected"

tmux_running=$(pgrep tmux)
if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
  tmux new-session -s "$session_name" -c $repo_dir/$selected
  exit 0
fi

previous_dir=$(pwd)
previous_session_id=$(tmux display-message -p '#{session_id}')

# Look up (and, if needed, resolve after creation) the target session by ID,
# not name: tmux's target syntax treats "." and ":" in a name as window/pane
# separators, so names like "🗂️  firefly.js" break name-based targets even
# with the "=" exact-match prefix.
session_id=$(tmux list-sessions -F '#{session_id}	#{session_name}' 2>/dev/null | awk -F'\t' -v n="$session_name" '$2 == n {print $1; exit}')
if [[ -z $session_id ]]; then
  session_id=$(tmux new-session -ds "$session_name" -c $repo_dir/$selected -P -F '#{session_id}')
fi

tmux switch-client -t "$session_id"

if [[ $previous_dir == $HOME ]]; then
  tmux kill-session -t "$previous_session_id"
fi
