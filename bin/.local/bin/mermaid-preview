#!/usr/bin/env bash
set -euo pipefail

# Watch a mermaid (.mmd) file and regenerate a PNG on every change via `mmdc`.
# The PNG is written to a per-run tmp dir (not the working directory) and is
# only `open`ed the first time it's generated, so subsequent regenerations
# just refresh the already-open preview.
#
# Usage: mermaid-preview <input.mmd> [resolution]
# Resolution presets (mmdc scale factor): standard (default), high, ultra

resolution_choices="standard/high/ultra"

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "Usage: mermaid-preview <input.mmd> [$resolution_choices]" >&2
  exit 1
fi

input="$1"
resolution="${2:-standard}"

if [[ ! -f "$input" ]]; then
  echo "File not found: $input" >&2
  exit 1
fi

case "$resolution" in
  standard) scale=1 ;;
  high) scale=2 ;;
  ultra) scale=4 ;;
  *)
    echo "Unknown resolution: $resolution (choices: $resolution_choices)" >&2
    exit 1
    ;;
esac

if ! command -v mmdc >/dev/null 2>&1; then
  echo "mmdc (mermaid-cli) not found in PATH" >&2
  exit 1
fi

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/mermaid-preview.XXXXXX")
trap 'rm -rf "$tmpdir"' EXIT

output="$tmpdir/$(basename "${input%.*}").png"

file_mtime() {
  stat -f %m "$input" 2>/dev/null || stat -c %Y "$input" 2>/dev/null
}

echo "Watching $input"
echo "Output: $output"
echo "Resolution: $resolution (scale ${scale}x)"

opened=false
last_mtime=""

while true; do
  mtime=$(file_mtime)
  if [[ "$mtime" != "$last_mtime" ]]; then
    last_mtime="$mtime"
    if mmdc_error=$(mmdc -i "$input" -o "$output" -s "$scale" 2>&1 >/dev/null); then
      echo "Regenerated at $(date '+%Y-%m-%d %H:%M:%S')"
      if [[ "$opened" == false ]]; then
        open "$output"
        opened=true
      fi
    else
      printf '\033[31mFailed to regenerate: %s\033[0m\n' "$mmdc_error" >&2
    fi
  fi
  sleep 1
done
